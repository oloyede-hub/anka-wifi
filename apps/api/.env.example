# Use these server settings in the monorepo root .env (anka-wifi/.env).
DATABASE_URL="postgresql://user:password@localhost:5432/mydb"
PAYSTACK_SECRET_KEY="sk_test_replace_me"
# Public Paystack key; server secrets must never use NEXT_PUBLIC_ prefixes.
PAYSTACK_PUBLIC_KEY="pk_test_replace_me"
PAYSTACK_BASE_URL="https://api.paystack.co"
# OPay test credentials from Merchant Dashboard > API Keys & Webhooks.
# Keep real values in the monorepo root .env, never NEXT_PUBLIC_*.
OPAY_MERCHANT_ID=""
OPAY_PUBLIC_KEY=""
OPAY_PRIVATE_KEY=""
OPAY_BASE_URL="https://testapi.opaycheckout.com"
# OPay callbacks require API_URL to be a publicly reachable HTTPS API origin.
FRONTEND_URL="http://localhost:3000"
API_URL="http://localhost:4000"
# Required: generate a random secret of at least 32 bytes before starting the API.
ADMIN_JWT_SECRET="replace_with_a_random_secret_of_at_least_32_bytes"
# Supports integer seconds or s/m/h suffixes; allowed range: 5 minutes to 24 hours.
ADMIN_JWT_EXPIRES_IN="1h"
# Bootstrap inputs are temporary process variables; do not store a real password here.
# ANKA_BOOTSTRAP_EMAIL="admin@example.com"
# ANKA_BOOTSTRAP_NAME="Administrator"
# ANKA_BOOTSTRAP_PASSWORD=""
