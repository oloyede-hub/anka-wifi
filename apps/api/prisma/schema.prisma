// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ========================
// ENUMS
// ========================

enum PackageStatus {
  ACTIVE
  INACTIVE
}

enum PackageType {
  DAILY
  WEEKLY
  MONTHLY
}

enum AccessCodeStatus {
  AVAILABLE
  RESERVED
  SOLD
  DISABLED
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REFUNDED
}

enum PaymentProvider {
  PAYSTACK
  FLUTTERWAVE
  MANUAL
}

// ========================
// ADMIN
// ========================

model Admin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ========================
// WIFI PACKAGE
// ========================

model WifiPackage {
  id          String        @id @default(cuid())
  name        String
  description String?
  type        PackageType
  price       Decimal       @db.Decimal(10, 2)
  status      PackageStatus @default(ACTIVE)
  featured    Boolean       @default(false)

  accessCodes AccessCode[]
  purchases   Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
}

// ========================
// ACCESS CODE
// ========================

model AccessCode {
  id     String           @id @default(cuid())
  code   String           @unique
  status AccessCodeStatus @default(AVAILABLE)

  packageId String
  package   WifiPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  // Set while a customer is checking out.
  reservedAt           DateTime?
  reservationExpiresAt DateTime?

  soldAt DateTime?

  purchase Purchase?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([packageId, status])
  @@index([status, reservationExpiresAt])
}

// ========================
// CUSTOMER
// ========================

model Customer {
  id    String @id @default(cuid())
  phone String
  email String

  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([phone])
  @@index([email])
}

// ========================
// PURCHASE
// ========================

model Purchase {
  id        String         @id @default(cuid())
  reference String         @unique
  status    PurchaseStatus @default(PENDING)
  amount    Decimal        @db.Decimal(10, 2)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  packageId String
  package   WifiPackage @relation(fields: [packageId], references: [id], onDelete: Restrict)

  accessCodeId String?     @unique
  accessCode   AccessCode? @relation(fields: [accessCodeId], references: [id], onDelete: Restrict)

  payment Payment[]

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
  @@index([packageId])
  @@index([status])
  @@index([createdAt])
}

// ========================
// PAYMENT
// ========================

model Payment {
  id String @id @default(cuid())

  reference         String          @unique
  providerReference String?         @unique
  provider          PaymentProvider
  status            PaymentStatus   @default(PENDING)

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("NGN")

  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  paidAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
